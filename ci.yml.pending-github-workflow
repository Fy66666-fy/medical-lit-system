name: CI

on:
  push:
    branches: ["main", "master"]
  pull_request:
    branches: ["main", "master"]

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: 安装依赖
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 语法编译检查
        run: python -m compileall -q app.py version.py launch.py release.py core

      - name: 请求层测试（离线）
        run: python _test_http.py

      - name: 日志系统测试
        run: python _test_logger.py

      - name: 翻译层测试
        run: python -m unittest _test_translate -v

      - name: 应用冒烟测试（AppTest）
        run: python _smoke_app.py

      - name: 版本号自检
        run: python -c "from version import APP_VERSION, VERSION_TUPLE; print(APP_VERSION, VERSION_TUPLE)"
